# 复制本文件为 .env 后填写。部署主机上的 dist 目录必须已经存在。
FRONTEND_HTML_PATH=/root/robot/super-agv-front

# 后端数据库连接。MySQL 必须允许 Docker 主机访问。
SPRING_DATASOURCE_URL=jdbc:mysql://39.105.68.15:50013/kunling?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=sunder
SPRING_DATASOURCE_PASSWORD="123456qwertQ"

# 机器人客户端连接宿主机使用的 TCP 端口；Web 页面与 HTTP API 固定使用 40023。
ROBOT_BRIDGE_HOST_PORT=8080

# 可按服务器资源调整。
JAVA_TOOL_OPTIONS=-Xms512m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
